{
  "name": "karaoke-stage",
  "description": "A themed CDG+MP3 karaoke player with multi-format support",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean:appledouble": "find . -name '._*' -not -path './node_modules/*' -delete",
    "desktop:dev": "npm run clean:appledouble && tauri dev",
    "desktop:build": "npm run clean:appledouble && tauri build"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "cdgraphics": "^7.0.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.9"
  }
}
